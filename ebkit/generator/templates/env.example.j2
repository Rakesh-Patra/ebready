{% if config.environment_variables -%}
# Application environment variables
{% for key in config.environment_variables -%}
{% if key == "PORT" -%}
PORT={{ config.port }}
{% else -%}
{{ key }}=
{% endif -%}
{% endfor -%}
{% if "PORT" not in config.environment_variables -%}
PORT={{ config.port }}
{% endif -%}
{% else -%}
# No application environment variables detected.
# Standard variables — adjust as needed
PORT={{ config.port }}
{% endif %}

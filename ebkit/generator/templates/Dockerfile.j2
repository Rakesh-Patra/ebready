# syntax=docker/dockerfile:1
# EBKit production candidate. Build, HTTP and image CVEs require verification.
# Target architecture: {{ config.platform.value }}
{% if config.language.value == "python" %}
FROM {{ 'python:3.13-slim-trixie' if use_distroless else config.base_image() }} AS build
WORKDIR /app
{% if config.dependency_file and config.package_manager.value in ['pip', 'unknown'] %}
COPY {{ config.dependency_file }} /tmp/requirements.txt
RUN pip install --no-cache-dir --target=/opt/site-packages -r /tmp/requirements.txt
{% else %}
RUN mkdir -p /opt/site-packages
{% endif %}
COPY . .
FROM {{ 'gcr.io/distroless/python3-debian13:nonroot' if use_distroless else config.base_image() }} AS runtime
WORKDIR /app
COPY --from=build --chown=65532:65532 /opt/site-packages /opt/site-packages
COPY --from=build --chown=65532:65532 /app /app
ENV PYTHONPATH=/opt/site-packages PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
USER 65532:65532
EXPOSE {{ config.port }}
STOPSIGNAL SIGTERM
{% if use_distroless %}
ENTRYPOINT ["/usr/bin/python3"]
CMD {{ (start_tokens[1:] if start_tokens[0] in ['python', 'python3'] else ['-m'] + start_tokens) | tojson }}
{% else %}
CMD {{ (['python', '-m'] + start_tokens if start_tokens[0] in ['uvicorn', 'gunicorn'] else start_tokens) | tojson }}
{% endif %}
{% elif config.language.value == "node" %}
FROM {{ config.builder_image() }} AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build --if-present && npm prune --omit=dev && npm cache clean --force
FROM {{ 'gcr.io/distroless/nodejs' + (config.runtime_version or '24').split('.')[0] + '-debian13:nonroot' if use_distroless else config.base_image() }} AS runtime
WORKDIR /app
COPY --from=build --chown=65532:65532 /app /app
ENV NODE_ENV=production
USER 65532:65532
EXPOSE {{ config.port }}
STOPSIGNAL SIGTERM
{% if use_distroless %}
ENTRYPOINT ["/nodejs/bin/node"]
CMD {{ start_tokens[1:] | tojson }}
{% else %}
CMD {{ start_tokens | tojson }}
{% endif %}
{% elif config.language.value == "go" %}
FROM {{ config.builder_image() }} AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/server .
FROM gcr.io/distroless/static-debian13:nonroot AS runtime
WORKDIR /app
COPY --from=build --chown=65532:65532 /out/server /app/server
USER 65532:65532
EXPOSE {{ config.port }}
STOPSIGNAL SIGTERM
ENTRYPOINT ["/app/server"]
{% elif config.language.value == "java" and config.package_manager.value == 'maven' %}
FROM maven:3.9-eclipse-temurin-{{ config.runtime_version or '21' }} AS build
WORKDIR /src
COPY pom.xml ./
RUN mvn -B dependency:go-offline
COPY . .
RUN mvn -B -DskipTests package && mkdir -p /out && cp target/*.jar /out/app.jar
FROM gcr.io/distroless/java{{ config.runtime_version or '21' }}-debian13:nonroot AS runtime
WORKDIR /app
COPY --from=build --chown=65532:65532 /out/app.jar /app/app.jar
USER 65532:65532
EXPOSE {{ config.port }}
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/bin/java", "-jar", "/app/app.jar"]
{% else %}
# No safe generic recipe for this package manager/runtime.
# AI generation must supply a complete Dockerfile which passes the quality gate.
{% endif %}

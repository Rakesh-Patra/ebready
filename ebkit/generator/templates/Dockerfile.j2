# syntax=docker/dockerfile:1
# Generated by ebkit — production container definition.
# Target Platform: {{ config.platform.value }} ({{ config.architecture }})
# Container Strategy: {{ config.container_strategy.value }}

{% if config.container_strategy.value == "multi_stage" -%}
# ── Stage 1: Build stage ───────────────────────────────────────────────────
FROM --platform={{ config.platform.value }} {{ config.builder_image() }} AS builder

WORKDIR /build

{% if config.language.value == "python" -%}
{% if config.dependency_file -%}
COPY {{ config.dependency_file }} .
{% if config.package_manager.value == "pip" or config.package_manager.value == "unknown" -%}
RUN pip install --no-cache-dir --prefix=/install -r {{ config.dependency_file }}
{% elif config.package_manager.value == "poetry" -%}
RUN pip install --no-cache-dir poetry && \
    poetry config virtualenvs.create false && \
    poetry install --no-dev --no-interaction --prefix=/install
{% elif config.package_manager.value == "pipenv" -%}
RUN pip install --no-cache-dir pipenv && \
    pipenv requirements > reqs.txt && \
    pip install --no-cache-dir --prefix=/install -r reqs.txt
{% endif -%}
{% endif -%}

# ── Stage 2: Runtime stage ────────────────────────────────────────────────
FROM --platform={{ config.platform.value }} {{ config.base_image() }} AS runner

WORKDIR /app

RUN groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -s /sbin/nologin -M appuser

COPY --from=builder /install /usr/local
COPY --chown=appuser:appgroup . .

USER appuser:appgroup

{% elif config.language.value == "node" -%}
{% if config.dependency_file -%}
COPY package*.json ./
{% if config.package_manager.value == "yarn" -%}
COPY yarn.lock ./
RUN yarn install --frozen-lockfile
{% elif config.package_manager.value == "pnpm" -%}
RUN npm install -g pnpm && pnpm install --frozen-lockfile
{% else -%}
RUN npm ci
{% endif -%}
{% endif -%}
COPY . .
RUN if [ -f "tsconfig.json" ] || grep -q '"build":' package.json 2>/dev/null; then npm run build --if-present; fi

# ── Stage 2: Runtime stage ────────────────────────────────────────────────
FROM --platform={{ config.platform.value }} {{ config.base_image() }} AS runner

WORKDIR /app

{% if config.dependency_file -%}
COPY package*.json ./
RUN npm ci --only=production && npm cache clean --force
{% endif -%}
COPY --from=builder --chown=node:node /build/dist ./dist 2>/dev/null || true
COPY --chown=node:node . .

USER node

{% elif config.language.value == "go" -%}
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /app/server .

# ── Stage 2: Runtime stage ────────────────────────────────────────────────
FROM --platform={{ config.platform.value }} alpine:3.20 AS runner

RUN addgroup -S appgroup && adduser -S appuser -G appgroup
WORKDIR /app
COPY --from=builder --chown=appuser:appgroup /app/server /app/server

USER appuser:appgroup

{% else -%}
FROM --platform={{ config.platform.value }} {{ config.base_image() }} AS runner
WORKDIR /app
COPY . .
{% endif -%}

{% elif config.container_strategy.value == "distroless" -%}
# ── Stage 1: Build stage ───────────────────────────────────────────────────
FROM --platform={{ config.platform.value }} {{ config.builder_image() }} AS builder
WORKDIR /build
COPY . .
{% if config.language.value == "go" -%}
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /build/server .
{% endif -%}

# ── Stage 2: Distroless Runtime ───────────────────────────────────────────
FROM --platform={{ config.platform.value }} gcr.io/distroless/static-debian12:nonroot AS runner
WORKDIR /app
COPY --from=builder /build/server /app/server
USER nonroot:nonroot

{% else -%}
# ── Single-stage production build ─────────────────────────────────────────
FROM --platform={{ config.platform.value }} {{ config.base_image() }}

WORKDIR /app

{% if config.language.value == "python" -%}
# Create unprivileged application user
RUN groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -s /sbin/nologin -M appuser

{% if config.dependency_file -%}
COPY {{ config.dependency_file }} .
{% if config.package_manager.value == "pip" or config.package_manager.value == "unknown" -%}
RUN pip install --no-cache-dir -r {{ config.dependency_file }}
{% elif config.package_manager.value == "poetry" -%}
RUN pip install --no-cache-dir poetry && \
    poetry config virtualenvs.create false && \
    poetry install --no-dev --no-interaction
{% elif config.package_manager.value == "pipenv" -%}
RUN pip install --no-cache-dir pipenv && \
    pipenv install --system --deploy
{% endif -%}
{% endif -%}

COPY --chown=appuser:appgroup . .

# Ensure non-root ownership
RUN chown -R appuser:appgroup /app

USER appuser:appgroup

{% elif config.language.value == "node" -%}
# Node official image provides unprivileged 'node' user
{% if config.dependency_file -%}
COPY package*.json ./
{% if config.package_manager.value == "yarn" -%}
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile --production && yarn cache clean
{% elif config.package_manager.value == "pnpm" -%}
RUN npm install -g pnpm && \
    pnpm install --frozen-lockfile --prod && \
    npm cache clean --force
{% else -%}
RUN npm ci --only=production && npm cache clean --force
{% endif -%}
{% endif -%}

COPY --chown=node:node . .

USER node

{% else -%}
COPY . .
{% endif -%}
{% endif -%}

EXPOSE {{ config.port }}

CMD {{ config.start_command.split() | tojson }}

INSFORGE_URL=
INSFORGE_ANON_KEY=
INSFORGE_API_KEY=
EBKIT_PYTHON=
EBKIT_LIVE_ENABLED=false
EBKIT_ALLOWED_EMAILS=
EBKIT_TESTING_EMAILS=
EBKIT_EVALUATOR_EMAILS=
EBKIT_WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Optional absolute path to a private persistent job directory.
EBKIT_JOBS_DIR=
# Operator key: server-only, never a VITE_ variable.
GEMINI_API_KEY=
EBKIT_GEMINI_MODEL=gemini-2.5-flash

# Includes provisioning, active trials and trials awaiting verified cleanup (1-10).
EBKIT_GLOBAL_CAPACITY=2

# Watch public GitHub default branches. ZIP sources are never watched.
EBKIT_GITHUB_AUTO_DEPLOY=true
EBKIT_GITHUB_POLL_SECONDS=300
# Optional server-only GitHub token to increase API request limits.
EBKIT_GITHUB_TOKEN=

# Optional named profiles for existing-project actions, all in this AWS account.
EBKIT_AWS_PROFILES=
EBKIT_AWS_ACCOUNT_ID=
